<ui:FluentWindow x:Class="TemplatePilot.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:TemplatePilot.Behaviors"
        xmlns:views="clr-namespace:TemplatePilot.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding AppTitle}"
        Width="980"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0"
                 Title="{Binding AppTitle}"
                 Icon="/Ressources/prg.ico" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Margin="12,8,6,12"
              Padding="10"
              Style="{StaticResource CardStyle}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="{Binding AppTitle}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{Binding ApplicationVersion, StringFormat=v{0}}"
                       Opacity="0.72"
                       FontSize="11" />
          </StackPanel>

          <ListBox x:Name="NavigationList"
                   SelectedIndex="{Binding SelectedNavigationIndex, Mode=TwoWay}"
                   ItemContainerStyle="{StaticResource NavigationItemStyle}"
                   BorderThickness="0"
                   Background="Transparent"
                   PreviewMouseLeftButtonUp="NavigationList_PreviewMouseLeftButtonUp">
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Home24" Margin="0,0,10,0" />
                <TextBlock Text="{Binding HomeText}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,10,0" />
                <TextBlock Text="{Binding TemplatesText}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" />
                <TextBlock Text="{Binding SettingsText}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" Margin="0,0,10,0" />
                <TextBlock Text="{Binding AboutText}" VerticalAlignment="Center" />
              </StackPanel>
            </ListBoxItem>
          </ListBox>
        </DockPanel>
      </Border>

      <TabControl Grid.Column="1"
                  Margin="6,8,12,12"
                  SelectedIndex="{Binding SelectedNavigationIndex, Mode=TwoWay}"
                  Style="{StaticResource PageHostTabControlStyle}">

        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
              <TextBlock Text="{Binding WelcomeTitleText}"
                         Style="{StaticResource HeaderTextStyle}"
                         FontSize="28" />
              <TextBlock Text="{Binding WelcomeText}"
                         Opacity="0.72"
                         Margin="0,6,0,20"
                         TextWrapping="Wrap" />

              <TextBlock Text="{Binding QuickActionsText}"
                         FontWeight="SemiBold"
                         FontSize="16"
                         Margin="0,0,0,10" />

              <UniformGrid Columns="2" Margin="0,0,0,18">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                  <StackPanel>
                    <ui:SymbolIcon Symbol="AddSquare24" FontSize="28" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding CreateTemplateText}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,10,0,4" />
                    <TextBlock Text="{Binding EditorDescriptionText}"
                               Opacity="0.72"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <ui:Button Content="{Binding NewText}"
                            Command="{Binding NewTemplateCommand}"
                            Appearance="Primary"
                            HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                  <StackPanel>
                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="28" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding TemplateLibraryText}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Margin="0,10,0,4" />
                    <TextBlock Text="{Binding TemplateLibraryDescriptionText}"
                               Opacity="0.72"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <ui:Button Content="{Binding OpenTemplatesText}"
                            Click="OpenTemplates_Click"
                            HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="{Binding SelectedTemplateText}"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedTemplateDisplayName}"
                             FontSize="20"
                             Margin="0,6,0,12" />
                  <ui:Button Content="{Binding EditSelectedTemplateText}"
                          Command="{Binding EditTemplateCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem>
          <Grid>
            <Grid Margin="8">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsEditorOpen}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="3*" MinHeight="220" />
              <RowDefinition Height="8" />
              <RowDefinition Height="2*" MinHeight="180" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <ui:Button Content="{Binding NewText}" Command="{Binding NewTemplateCommand}"
                        Appearance="Primary" />
                <ui:Button Content="{Binding EditText}" Command="{Binding EditTemplateCommand}" />
                <ui:Button Content="{Binding DeleteText}" Command="{Binding DeleteTemplateCommand}"
                        Appearance="Danger" />
                <ui:Button Content="{Binding DuplicateText}" Command="{Binding DuplicateTemplateCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <ui:Button Content="{Binding ImportText}" Command="{Binding ImportCommand}" />
                <ui:Button Content="{Binding ExportText}" Command="{Binding ExportCommand}" Margin="8,0,0,0" />
              </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
              <TabControl SelectedIndex="{Binding ActiveTabIndex}">
                <TabItem Header="{Binding TemplatesText}">
                  <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="{Binding SearchTextLabel}" />
                      <ComboBox Grid.Column="2"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                ToolTip="{Binding CategoryFilterText}" />
                      <ui:Button Grid.Column="3"
                              Content="×"
                              Command="{Binding ClearCategoryFilterCommand}"
                              ToolTip="{Binding ClearCategoryFilterText}"
                              Margin="6,0,0,0"
                              MinWidth="34" />
                    </Grid>
                    <ui:DataGrid Grid.Row="1"
                                 x:Name="TemplatesGrid"
                                 HorizontalAlignment="Stretch"
                                 AutoGenerateColumns="False"
                                 CanUserSortColumns="True"
                                 RowHeight="24"
                                 MinRowHeight="24"
                                 ColumnHeaderHeight="32"
                                 HeadersVisibility="Column"
                                 GridLinesVisibility="None"
                                 HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding TemplatesView}"
                                 SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                 MouseDoubleClick="TemplatesGrid_MouseDoubleClick">
                      <ui:DataGrid.Columns>
                        <DataGridTextColumn x:Name="TemplateKeyColumn"
                                            Binding="{Binding Metadata.Key}"
                                            Width="360"
                                            CanUserSort="True"
                                            SortMemberPath="Metadata.Key" />
                        <DataGridTextColumn x:Name="TemplateCategoryColumn"
                                            Binding="{Binding Metadata.Category}"
                                            Width="100"
                                            CanUserSort="True"
                                            SortMemberPath="Metadata.Category" />
                        <DataGridTemplateColumn Width="*"
                                                CanUserSort="False"
                                                IsReadOnly="True" />
                      </ui:DataGrid.Columns>
                    </ui:DataGrid>
                  </Grid>
                </TabItem>

                <TabItem Header="{Binding CategoriesText}">
                  <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding CategoryEditText, UpdateSourceTrigger=PropertyChanged}" />
                      <ui:Button Grid.Column="1" Content="{Binding NewCategoryText}" Command="{Binding NewCategoryCommand}" Margin="8,0,0,0" />
                      <ui:Button Grid.Column="2" Content="{Binding SaveCategoryText}" Command="{Binding SaveCategoryCommand}" Margin="8,0,0,0" />
                      <ui:Button Grid.Column="3" Content="{Binding DeleteCategoryText}" Command="{Binding DeleteCategoryCommand}" Margin="8,0,0,0" />
                    </Grid>
                  </Grid>
                </TabItem>
              </TabControl>
            </Border>

            <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" />

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding PreviewLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TabControl Grid.Row="1">
                  <TabItem Header="{Binding PlainTextLabel}">
                    <TextBox Text="{Binding SelectedTemplate.Content.PlainText}"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />
                  </TabItem>
                  <TabItem Header="{Binding RichTextLabel}">
                    <RichTextBox IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 behaviors:RichTextBoxRtfBehavior.RtfText="{Binding SelectedTemplate.Content.Rtf}" />
                  </TabItem>
                  <TabItem Header="{Binding HtmlLabel}">
                    <wv2:WebView2 x:Name="HtmlPreview" />
                  </TabItem>
                  <TabItem Header="{Binding ImagesLabel}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding SelectedTemplate.Content.Images}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                    Padding="8" Margin="0,0,0,8">
                              <StackPanel>
                                <TextBlock Text="{Binding FileName}" Margin="0,0,0,6" />
                                <Image Source="{Binding Bytes, Converter={StaticResource ImageBytesToBitmapSourceConverter}}"
                                       MaxHeight="220" Stretch="Uniform" HorizontalAlignment="Left" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </TabItem>
                </TabControl>
              </Grid>
            </Border>
            </Grid>
            <views:TemplateEditorView DataContext="{Binding ActiveEditor}"
                                      Margin="8">
              <views:TemplateEditorView.Style>
                <Style TargetType="{x:Type views:TemplateEditorView}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsEditorOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </views:TemplateEditorView.Style>
            </views:TemplateEditorView>
          </Grid>
        </TabItem>

        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8" MaxWidth="760" HorizontalAlignment="Left">
              <TextBlock Text="{Binding SettingsText}" Style="{StaticResource HeaderTextStyle}" FontSize="26" />
              <TextBlock Text="{Binding SettingsDescriptionText}"
                         Opacity="0.72"
                         Margin="0,4,0,16" TextWrapping="Wrap" />

              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{Binding LanguageLabel}" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            ItemsSource="{Binding AvailableLanguages}"
                            SelectedItem="{Binding SelectedLanguage}"
                            MinWidth="220" />
                  <TextBlock Grid.Row="1" Text="{Binding ThemeText}" VerticalAlignment="Center" Margin="0,12,0,0" />
                  <ComboBox Grid.Row="1" Grid.Column="1"
                            ItemsSource="{Binding AvailableThemes}"
                            SelectedItem="{Binding SelectedTheme}"
                            MinWidth="220" Margin="0,12,0,0" />
                </Grid>
              </Border>

              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TemplatesFolderLabel}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding TemplatesPath}"
                           IsReadOnly="True"
                           MinWidth="360"
                           Margin="0,0,8,0" />
                  <ui:Button Grid.Column="2"
                             Content="{Binding ChooseFolderText}"
                             Command="{Binding BrowseTemplatesFolderCommand}" />
                </Grid>
              </Border>

              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="{Binding ShortcutText}" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <WrapPanel>
                    <CheckBox Content="{Binding CtrlText}" IsChecked="{Binding ShortcutControl}" Margin="0,0,12,8" />
                    <CheckBox Content="{Binding ShiftText}" IsChecked="{Binding ShortcutShift}" Margin="0,0,12,8" />
                    <CheckBox Content="{Binding AltText}" IsChecked="{Binding ShortcutAlt}" Margin="0,0,12,8" />
                    <CheckBox Content="{Binding WinText}" IsChecked="{Binding ShortcutWin}" Margin="0,0,12,8" />
                    <TextBox Width="60" Text="{Binding ShortcutKey, UpdateSourceTrigger=PropertyChanged}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                  <CheckBox Content="{Binding StartWithWindowsLabel}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8" />
                  <CheckBox Content="{Binding MinimizeToTrayLabel}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,8" />
                  <CheckBox Content="{Binding CloseToTrayLabel}" IsChecked="{Binding CloseToTray}" />
                </StackPanel>
              </Border>

              <ui:Button Content="{Binding SaveText}"
                      Command="{Binding SaveSettingsCommand}"
                      Appearance="Primary"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Source="/Ressources/prg.png"
                       Width="84"
                       Height="84"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                  <TextBlock Text="{Binding AppTitle}"
                             FontSize="24"
                             FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AboutDescriptionText}"
                             TextWrapping="Wrap"
                             Opacity="0.72"
                             Margin="0,4,0,10" />
                  <TextBlock>
                    <Run Text="{Binding CopyrightText, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Margin="0,4,0,0">
                    <Run Text="{Binding VersionText, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=": " />
                    <Run Text="{Binding ApplicationVersion, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Margin="0,4,0,0">
                    <Run Text="{Binding LicenseText, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=": MIT" />
                  </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,18,0,0">
                  <ui:Button Content="{Binding RepositoryText}"
                             Command="{Binding OpenRepositoryCommand}"
                             HorizontalAlignment="Left" />
                  <ui:Button Content="{Binding ReleasesText}"
                             Command="{Binding OpenReleasesCommand}"
                             HorizontalAlignment="Left"
                             Margin="0,8,0,0" />
                </StackPanel>

                <Separator Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="0,18,0,14" />

                <Grid Grid.Row="3" Grid.ColumnSpan="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding UpdateStatus}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Margin="0,0,12,0" />
                  <ui:Button Grid.Column="1"
                             Content="{Binding CheckForUpdatesText}"
                             Command="{Binding CheckForUpdatesCommand}"
                             Appearance="Primary" />
                </Grid>
              </Grid>
            </Border>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Grid>
</ui:FluentWindow>
