<Application x:Class="TemplatePilot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TemplatePilot.Helpers">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Dimensions.xaml" />
        <ResourceDictionary Source="Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Semantic Anchor: ThemeMaterialDefaults | Values are replaced only by AppThemeService on a theme change. -->
      <SolidColorBrush x:Key="TemplatePilotWindowSurfaceBrush" Color="#FF202020" />
      <!-- Semantic Anchor: SearchPopupLayeredGlassSurface
           SSOT: AppThemeService derives the popup-only tint from the selected Glass theme and transparency level.
           Invariant: non-Glass themes retain the existing opaque window surface. -->
      <SolidColorBrush x:Key="TemplatePilotPopupSurfaceBrush" Color="#FF202020" />
      <!-- Semantic Anchor: FloatingMenuMaterial
           SSOT: AppThemeService provides a separate, theme-matched, near-opaque surface
           for floating menus. Ordinary Glass cards and popup transparency remain unchanged. -->
      <SolidColorBrush x:Key="TemplatePilotFloatingMenuSurfaceBrush" Color="#FF202020" />
      <!-- Semantic Anchor: SearchPopupSelectionContrastDefault
           SSOT: AppThemeService updates this foreground against the selected row accent. -->
      <SolidColorBrush x:Key="TemplatePilotPopupSelectionTextBrush" Color="White" />
      <SolidColorBrush x:Key="TemplatePilotCardSurfaceBrush" Color="#FF292929" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <helpers:ImageBytesToBitmapSourceConverter x:Key="ImageBytesToBitmapSourceConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
