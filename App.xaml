<Application x:Class="TemplatePilot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:TemplatePilot.Helpers">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Dimensions.xaml" />
        <ResourceDictionary Source="Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Semantic Anchor: ThemeMaterialDefaults | Values are replaced only by AppThemeService on a theme change. -->
      <SolidColorBrush x:Key="TemplatePilotWindowSurfaceBrush" Color="#FF202020" />
      <SolidColorBrush x:Key="TemplatePilotCardSurfaceBrush" Color="#FF292929" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <helpers:ImageBytesToBitmapSourceConverter x:Key="ImageBytesToBitmapSourceConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
