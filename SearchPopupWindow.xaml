<ui:FluentWindow x:Class="TemplatePilot.Views.SearchPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="620"
        Height="360"
        WindowStyle="None"
        ExtendsContentIntoTitleBar="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Border Background="{DynamicResource ApplicationBackgroundBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CornerNormal}"
          Padding="8"
          MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <Image Source="/Ressources/prg.png" Width="26" Height="26" Margin="0,0,8,0" DockPanel.Dock="Left" />

        <Grid DockPanel.Dock="Right" Width="32" Margin="8,0,0,0">
          <ToggleButton x:Name="CategoryFilterButton"
                        Width="28"
                        Height="24"
                        MinWidth="28"
                        Padding="0"
                        ToolTip="{Binding CategoryFilterLabel}">
            <Viewbox Width="14" Height="14">
              <Canvas Width="16" Height="16">
                <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                      Data="M1,3 L15,3 L10,8 L10,13 L6,15 L6,8 Z" />
              </Canvas>
            </Viewbox>
          </ToggleButton>
          <Popup IsOpen="{Binding IsChecked, ElementName=CategoryFilterButton}"
                 PlacementTarget="{Binding ElementName=CategoryFilterButton}"
                 Placement="Bottom"
                 StaysOpen="False"
                 AllowsTransparency="True">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="8"
                    Width="220">
              <StackPanel>
                <TextBlock Text="{Binding CategoryFilterLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ui:Button Content="{Binding AllCategoriesText}"
                        Command="{Binding ClearCategoryFilterCommand}"
                        HorizontalAlignment="Stretch"
                        Height="24"
                        Margin="0,0,0,8" />
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding CategoryFilters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <TextBox x:Name="FilterTextBox"
                 Height="24"
                 MinHeight="22"
                 Padding="6,2"
                 VerticalContentAlignment="Center"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding HintText}" />
      </DockPanel>

      <DataGrid x:Name="TemplateList"
                Grid.Row="1"
                ItemsSource="{Binding TemplatesView}"
                SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                MouseDoubleClick="TemplateList_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Metadata.Key}" Width="110">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.KeyLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn Binding="{Binding Metadata.Category}" Width="120">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.CategoryLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTemplateColumn Width="*">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding DataContext.PreviewLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Content.PlainText}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="18"
                           MaxHeight="90"
                           Margin="4,2"
                           VerticalAlignment="Top" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <DockPanel Grid.Row="2" Margin="0,8,0,0">
        <TextBlock Text="{Binding EscapeKeyText}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Left" />
        <ui:Button Content="{Binding InsertText}"
                Command="{Binding ConfirmCommand}"
                HorizontalAlignment="Right"
                DockPanel.Dock="Right"
                Appearance="Primary" />
      </DockPanel>
    </Grid>
  </Border>
</ui:FluentWindow>
