<ui:FluentWindow x:Class="TemplatePilot.Views.SearchPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="860"
        Height="360"
        MinWidth="520"
        MinHeight="260"
        WindowStyle="None"
        ExtendsContentIntoTitleBar="False"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="{DynamicResource TemplatePilotWindowSurfaceBrush}"
        FontSize="12"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Border Background="{DynamicResource TemplatePilotWindowSurfaceBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CornerNormal}"
          Padding="8"
          MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- Semantic Anchor: SearchPopupSplitLayout | SSOT: the window owns the list/preview panel geometry. Invariants: preview occupies a full-height dedicated right column, never a DataGrid column; hiding it releases its width without changing template selection. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="PreviewPanelColumn" Width="280" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,8">
        <Image Source="/Ressources/templatepilot.png" Width="26" Height="26" Margin="0,0,8,0" DockPanel.Dock="Left" />

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
          <Button x:Name="PreviewPanelToggleButton" Content="‹" Width="28" Height="24" Margin="0,0,6,0"
                  Padding="0" ToolTip="Toggle preview" Click="PreviewPanelToggleButton_Click" />
        <Grid Width="32">
          <ToggleButton x:Name="CategoryFilterButton"
                        Width="28"
                        Height="24"
                        MinWidth="28"
                        Padding="0"
                        ToolTip="{Binding CategoryFilterLabel}">
            <Viewbox Width="14" Height="14">
              <Canvas Width="16" Height="16">
                <Path Fill="{DynamicResource TextFillColorPrimaryBrush}"
                      Data="M1,3 L15,3 L10,8 L10,13 L6,15 L6,8 Z" />
              </Canvas>
            </Viewbox>
          </ToggleButton>
          <Popup IsOpen="{Binding IsChecked, ElementName=CategoryFilterButton}"
                 PlacementTarget="{Binding ElementName=CategoryFilterButton}"
                 Placement="Bottom"
                 StaysOpen="False"
                 AllowsTransparency="False">
            <Border Background="{DynamicResource TemplatePilotCardSurfaceBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="10"
                    Width="220">
              <StackPanel>
                <TextBlock Text="{Binding CategoryFilterLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ui:Button Content="{Binding AllCategoriesText}"
                        Command="{Binding ClearCategoryFilterCommand}"
                        HorizontalAlignment="Stretch"
                        Height="36"
                        MinHeight="36"
                        Padding="10,6"
                        Margin="0,0,0,8" />
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding CategoryFilters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Name}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
        </StackPanel>

        <TextBox x:Name="FilterTextBox"
                 Height="24"
                 MinHeight="22"
                 Padding="6,2"
                 VerticalContentAlignment="Center"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding HintText}" />
      </DockPanel>

      <!-- Semantic Anchor: PopupTypography | SSOT: SearchPopupFontSize drives both text areas; row height is auto-derived from text; popup controls retain their existing typography. -->
      <!-- Semantic Anchor: SinglePopupTemplateSelection | SSOT: SelectedTemplate identifies the one active search result. Invariants: no multi-selection with Shift/Ctrl; preview and insert track the selected row. -->
      <!-- Semantic Anchor: SearchPopupGlassSurface
           SSOT: AppThemeService supplies window/card material brushes to all popup panels.
           Invariants: list selection, keyboard actions, typography and popup geometry are unchanged. -->
      <DataGrid x:Name="TemplateList"
                Background="{DynamicResource TemplatePilotWindowSurfaceBrush}"
                FontSize="{Binding SearchPopupFontSize}"
                 RowHeight="NaN"
                 SelectionMode="Single"
                SelectionUnit="FullRow"
                Grid.Row="1"
                ItemsSource="{Binding TemplatesView}"
                SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                IsReadOnly="True"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Top"
                AlternationCount="2"
                GridLinesVisibility="None"
                HorizontalScrollBarVisibility="Disabled"
                ColumnReordered="TemplateList_ColumnReordered"
                MouseDoubleClick="TemplateList_MouseDoubleClick">
        <DataGrid.Resources>
          <Style x:Key="TemplateListTextElementStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                <Setter Property="Foreground" Value="White" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.Resources>
        <DataGrid.CellStyle>
          <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.CellStyle>
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <!-- Semantic Anchor: SearchPopupRowGlassMaterial
                 SSOT: AppThemeService supplies the same WindowSurfaceBrush as the popup itself.
                 Invariants: unselected rows never create an opaque panel over Acrylic;
                 alternating and selected row styles retain their existing priorities. -->
            <Setter Property="Background" Value="{DynamicResource TemplatePilotWindowSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
              <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource TemplatePilotCardSurfaceBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="BorderBrush" Value="Transparent" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn x:Name="KeyColumn" Binding="{Binding Metadata.Key}" Width="*" ElementStyle="{StaticResource TemplateListTextElementStyle}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.KeyLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTextColumn x:Name="CategoryColumn" Binding="{Binding Metadata.Category}" Width="110" ElementStyle="{StaticResource TemplateListTextElementStyle}">
            <DataGridTextColumn.Header>
              <TextBlock Text="{Binding DataContext.CategoryLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataGridTextColumn.Header>
          </DataGridTextColumn>
          <DataGridTemplateColumn x:Name="PreviewColumn" Width="*" Visibility="Collapsed">
            <DataGridTemplateColumn.Header>
              <TextBlock Text="{Binding DataContext.PreviewLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Content.PlainText}"
                           Style="{StaticResource TemplateListTextElementStyle}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           LineHeight="18"
                           LineStackingStrategy="BlockLineHeight"
                           Height="{Binding DataContext.SearchPopupTextMaxHeight, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                           Margin="4,2"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <DockPanel Grid.Row="2" Margin="0,8,0,0">
        <TextBlock Text="{Binding EscapeKeyText}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   VerticalAlignment="Center"
                   DockPanel.Dock="Left" />
        <ui:Button Content="{Binding InsertText}"
                Command="{Binding ConfirmCommand}"
                HorizontalAlignment="Right"
                DockPanel.Dock="Right"
                Appearance="Primary" />
      </DockPanel>
      </Grid>
      <!-- Semantic Anchor: SearchPreviewPanel | Invariant: selection is bound to the same SelectedTemplate as the list; no duplicate selection state. -->
      <Border x:Name="PreviewPanel" Grid.Column="1" Margin="8,0,0,0" Padding="10"
              Background="{DynamicResource TemplatePilotCardSurfaceBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewLabel}" FontWeight="SemiBold" Margin="0,0,0,10" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding SelectedTemplate.Content.PlainText}" FontSize="{Binding SearchPopupFontSize}" TextWrapping="Wrap" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</ui:FluentWindow>
