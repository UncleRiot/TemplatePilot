<Window x:Class="TemplatePilot.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:TemplatePilot.Behaviors"
        Title="{Binding WindowTitle}"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closed="Window_Closed">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
      <DockPanel>
        <Image Source="/Ressources/prg.png" Width="32" Height="32" Margin="0,0,10,0" DockPanel.Dock="Left" />
        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource HeaderTextStyle}" />
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding KeyLabel}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,8" />

        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding NameLabel}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CategoryLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0">
          <Button Content="+"
                  Command="{Binding AddCategoryCommand}"
                  ToolTip="{Binding AddCategoryText}"
                  Width="32"
                  Margin="8,0,0,0"
                  DockPanel.Dock="Right" />
          <ComboBox ItemsSource="{Binding AvailableCategories}"
                    Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                    IsEditable="True"
                    IsTextSearchEnabled="True" />
        </DockPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
      <TabControl>
        <TabItem Header="{Binding PlainTextLabel}">
          <TextBox x:Name="PlainEditor"
                   Text="{Binding PlainText, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   AcceptsTab="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto" />
        </TabItem>

        <TabItem Header="{Binding RichTextLabel}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="{Binding UndoText}" Click="RtfUndo_Click" />
              <Button Content="{Binding RedoText}" Click="RtfRedo_Click" />
            </StackPanel>
            <RichTextBox x:Name="RtfEditor"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         behaviors:RichTextBoxRtfBehavior.RtfText="{Binding Rtf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
        </TabItem>

        <TabItem Header="{Binding HtmlLabel}">
          <TextBox Text="{Binding Html, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   AcceptsTab="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   FontFamily="Consolas" />
        </TabItem>

        <TabItem Header="{Binding ImagesLabel}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding DragDropImageText}"
                       Foreground="{StaticResource BrushMutedText}"
                       Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,0,0,8">
                    <Image Source="{Binding Bytes, Converter={StaticResource ImageBytesToBitmapSourceConverter}}"
                           Width="120"
                           Height="90"
                           Stretch="Uniform"
                           Margin="0,0,10,0" />
                    <StackPanel>
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding MediaType}" Foreground="{StaticResource BrushMutedText}" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button Content="{Binding RemoveImageText}" Command="{Binding RemoveImageCommand}" DockPanel.Dock="Left" />
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
        <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="0" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
