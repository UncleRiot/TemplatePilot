<Window x:Class="TemplatePilot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:TemplatePilot.Behaviors"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{Binding AppTitle}"
        Width="1000"
        Height="680"
        MinWidth="760"
        MinHeight="500"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="6">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Command="{Binding ActiveNewCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="32"
                    Height="28"
                    MinWidth="32"
                    Padding="0"
                    ToolTip="{Binding NewText}"
                    Content="＋"
                    FontSize="16" />
            <Button Command="{Binding ActiveEditCommand}"
                    Width="32"
                    Height="28"
                    MinWidth="32"
                    Padding="0"
                    ToolTip="{Binding EditText}"
                    Content="✎"
                    FontSize="16" />
            <Button Command="{Binding ActiveSaveCommand}"
                    Width="32"
                    Height="28"
                    MinWidth="32"
                    Padding="0"
                    ToolTip="{Binding SaveText}"
                    Content="💾"
                    FontSize="14" />
            <Button Command="{Binding ActiveDeleteCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="32"
                    Height="28"
                    MinWidth="32"
                    Padding="0"
                    Margin="0"
                    ToolTip="{Binding DeleteText}"
                    Content="🗑"
                    FontSize="14" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Command="{Binding ImportCommand}"
                    Width="32"
                    Height="28"
                    MinWidth="32"
                    Padding="0"
                    ToolTip="{Binding ImportText}"
                    Content="⭳"
                    FontSize="16" />
            <Button Command="{Binding ExportCommand}"
                    Width="32"
                    Height="28"
                    MinWidth="32"
                    Padding="0"
                    Margin="6,0,0,0"
                    ToolTip="{Binding ExportText}"
                    Content="⭱"
                    FontSize="16" />
            <ToggleButton x:Name="SettingsToggle"
                          Width="32"
                          Height="28"
                          MinWidth="32"
                          Padding="0"
                          Margin="6,0,0,0"
                          ToolTip="{Binding SettingsText}"
                          Content="⚙"
                          FontSize="16"
                          Checked="SettingsToggle_Checked"
                          Unchecked="SettingsToggle_Unchecked" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*" MinHeight="210" />
          <RowDefinition Height="6" />
          <RowDefinition Height="2*" MinHeight="170" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="10">
          <TabControl SelectedIndex="{Binding ActiveTabIndex}">
            <TabItem Header="{Binding TemplatesText}">
              <Grid Margin="0,6,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Viewbox Width="16"
                             Height="16"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             ToolTip="{Binding SearchTextLabel}">
                      <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="2"
                                 Canvas.Top="2"
                                 Width="9"
                                 Height="9"
                                 Stroke="{StaticResource BrushText}"
                                 StrokeThickness="1.6" />
                        <Line X1="9"
                              Y1="9"
                              X2="14"
                              Y2="14"
                              Stroke="{StaticResource BrushText}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                      </Canvas>
                    </Viewbox>

                    <TextBox Width="220"
                             Height="24"
                             MinHeight="22"
                             Padding="6,2"
                             ToolTip="{Binding SearchTextLabel}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Viewbox Width="16"
                             Height="16"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             ToolTip="{Binding CategoryFilterText}">
                      <Canvas Width="16" Height="16">
                        <Path Fill="{StaticResource BrushText}"
                              Data="M1,3 L15,3 L10,8 L10,13 L6,15 L6,8 Z" />
                      </Canvas>
                    </Viewbox>

                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                              Width="180"
                              Height="24"
                              MinHeight="22"
                              Padding="4,0"
                              Margin="0,0,6,0"
                              ToolTip="{Binding CategoryFilterText}" />

                    <Button Command="{Binding ClearCategoryFilterCommand}"
                            Width="28"
                            Height="24"
                            MinHeight="22"
                            Padding="0"
                            Margin="0"
                            ToolTip="{Binding ClearCategoryFilterText}">
                      <Viewbox Width="14" Height="14">
                        <Canvas Width="16" Height="16">
                          <Path Stroke="{StaticResource BrushText}"
                                StrokeThickness="1.7"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                Fill="Transparent"
                                Data="M12.5,5.5 A5,5 0 1 0 13,10" />
                          <Path Fill="{StaticResource BrushText}"
                                Data="M12.5,1.8 L12.5,5.8 L8.8,5.8 Z" />
                        </Canvas>
                      </Viewbox>
                    </Button>
                  </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          x:Name="TemplatesGrid"
                          ItemsSource="{Binding TemplatesView}"
                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          MouseDoubleClick="TemplatesGrid_MouseDoubleClick">
                  <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Metadata.Key}" Width="2*">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.KeyLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Metadata.Category}" Width="*">
                      <DataGridTextColumn.Header>
                        <TextBlock Text="{Binding DataContext.CategoryLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                      </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <TabItem Header="{Binding CategoriesText}">
              <Grid Margin="0,6,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                  <TextBlock Text="{Binding CategoryLabel}" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left" />
                  <TextBox Text="{Binding CategoryEditText, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>

        <GridSplitter Grid.Row="1"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      Background="Transparent" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding PreviewLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />

            <TabControl Grid.Row="1">
              <TabItem Header="{Binding PlainTextLabel}">
                <TextBox Text="{Binding SelectedTemplate.Content.PlainText}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
              </TabItem>
              <TabItem Header="{Binding RichTextLabel}">
                <RichTextBox IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             behaviors:RichTextBoxRtfBehavior.RtfText="{Binding SelectedTemplate.Content.Rtf}" />
              </TabItem>
              <TabItem Header="{Binding HtmlLabel}">
                <wv2:WebView2 x:Name="HtmlPreview" />
              </TabItem>
              <TabItem Header="{Binding ImagesLabel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding SelectedTemplate.Content.Images}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                          <StackPanel>
                            <TextBlock Text="{Binding FileName}" Margin="0,0,0,6" />
                            <Image Source="{Binding Bytes, Converter={StaticResource ImageBytesToBitmapSourceConverter}}"
                                   MaxHeight="220"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Left" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="SettingsPanel"
            Grid.Column="1"
            Width="220"
            Visibility="Collapsed"
            Style="{StaticResource CardStyle}"
            Margin="0,10,10,10"
            Padding="12">
      <StackPanel HorizontalAlignment="Left">
        <TextBlock Text="{Binding SettingsText}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <TextBlock Text="{Binding LanguageLabel}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  Width="170"
                  Height="24"
                  MinHeight="22"
                  Padding="4,0"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,10" />

        <TextBlock Text="{Binding ShortcutText}" Margin="0,0,0,4" />
        <WrapPanel Width="190" Margin="0,0,0,8">
          <CheckBox Content="Ctrl" IsChecked="{Binding ShortcutControl}" VerticalAlignment="Center" Margin="0,0,6,6" />
          <CheckBox Content="Shift" IsChecked="{Binding ShortcutShift}" VerticalAlignment="Center" Margin="0,0,6,6" />
          <CheckBox Content="Alt" IsChecked="{Binding ShortcutAlt}" VerticalAlignment="Center" Margin="0,0,6,6" />
          <CheckBox Content="Win" IsChecked="{Binding ShortcutWin}" VerticalAlignment="Center" Margin="0,0,6,6" />
          <TextBox Width="34"
                   Height="24"
                   MinHeight="22"
                   Padding="4,2"
                   Text="{Binding ShortcutKey, UpdateSourceTrigger=PropertyChanged}" />
        </WrapPanel>

        <CheckBox Content="{Binding StartWithWindowsLabel}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,6" />
        <CheckBox Content="{Binding MinimizeToTrayLabel}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,6" />
        <CheckBox Content="{Binding CloseToTrayLabel}" IsChecked="{Binding CloseToTray}" Margin="0,0,0,10" />

        <Button Content="{Binding SaveText}"
                Command="{Binding SaveSettingsCommand}"
                HorizontalAlignment="Left"
                Style="{StaticResource PrimaryButtonStyle}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
