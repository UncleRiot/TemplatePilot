<ui:FluentWindow x:Class="TemplatePilot.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:TemplatePilot.Behaviors"
        Title="{Binding WindowTitle}"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="False"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closed="Window_Closed">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="34" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding KeyLabel}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <TextBox Grid.Column="1"
                 Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                 Height="24"
                 MinHeight="22"
                 Padding="6,2"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Column="3"
                   Text="{Binding CategoryLabel}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <ComboBox Grid.Column="4"
                  ItemsSource="{Binding AvailableCategories}"
                  SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEditable="False"
                  IsTextSearchEnabled="True"
                  Height="24"
                  MinHeight="22"
                  Padding="4,0" />
        <ui:Button Grid.Column="5"
                Content="+"
                Command="{Binding AddCategoryCommand}"
                ToolTip="{Binding AddCategoryText}"
                Width="28"
                Height="24"
                MinWidth="28"
                Padding="0"
                Margin="6,0,0,0" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
      <TabControl>
        <TabItem Header="{Binding PlainTextLabel}">
          <TextBox x:Name="PlainEditor"
                   Text="{Binding PlainText, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   AcceptsTab="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto" />
        </TabItem>

        <TabItem Header="{Binding RichTextLabel}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <ui:Button Content="{Binding UndoText}" Click="RtfUndo_Click" />
              <ui:Button Content="{Binding RedoText}" Click="RtfRedo_Click" />
            </StackPanel>
            <RichTextBox x:Name="RtfEditor"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         behaviors:RichTextBoxRtfBehavior.RtfText="{Binding Rtf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
        </TabItem>

        <TabItem Header="{Binding HtmlLabel}">
          <TextBox Text="{Binding Html, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True"
                   AcceptsTab="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto" />
        </TabItem>

        <TabItem Header="{Binding ImagesLabel}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding DragDropImageText}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding Images}"
                     SelectedItem="{Binding SelectedImage, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Bytes, Converter={StaticResource ImageBytesToBitmapSourceConverter}}"
                           MaxWidth="110"
                           MaxHeight="80"
                           Stretch="Uniform" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FileName}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,8,0,0">
      <ui:Button Content="{Binding RemoveImageText}"
              Command="{Binding RemoveImageCommand}"
              DockPanel.Dock="Left"
              Margin="0,0,8,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button Content="{Binding SaveText}"
                Command="{Binding SaveCommand}"
                Appearance="Primary" />
        <ui:Button Content="{Binding CancelText}"
                Command="{Binding CancelCommand}"
                Margin="8,0,0,0" />
      </StackPanel>
    </DockPanel>
  </Grid>
</ui:FluentWindow>
